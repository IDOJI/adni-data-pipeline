*.sif

# Explicit user-approved CC0 public MRI sample; retain all other imaging exclusions.
!/RS-fMRI/support/reproducibility/public_data/ds000030-1.0.0/sub-10159/anat/sub-10159_T1w.nii.gz
!/RS-fMRI/support/reproducibility/public_data/ds000030-1.0.0/sub-10159/func/sub-10159_task-rest_bold.nii.gz

# Original result/assets may remain in an initialized live clone, never as imported source.
/RS-fMRI/support/pipeline/.claude/
/RS-fMRI/support/pipeline/.github/
/RS-fMRI/support/pipeline/WARP.md
/RS-fMRI/support/pipeline/**/*.png
