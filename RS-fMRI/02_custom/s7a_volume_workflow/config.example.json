{
  "schema_version": 1,
  "images": {
    "fmriprep": "nipreps/fmriprep:25.2.7",
    "xcpd": "pennlinc/xcp_d:26.2.0"
  },
  "platform": "linux/amd64",
  "cpus": 8,
  "omp_nthreads": 4,
  "docker_memory": "24g",
  "memory_mb": 20000,
  "random_seed": 20261028,
  "task": "rest",
  "fs_license": "/ABSOLUTE/PATH/freesurfer/license.txt",
  "paths": {
    "bids": "/ABSOLUTE/PATH/ADNI_DATA/volume/bids",
    "fmriprep_output": "/ABSOLUTE/PATH/ADNI_DATA/volume/fmriprep_output",
    "xcpd_output": "/ABSOLUTE/PATH/ADNI_DATA/volume/xcpd_output",
    "fmriprep_work": "/ABSOLUTE/PATH/ADNI_DATA/volume/fmriprep_work",
    "xcpd_work": "/ABSOLUTE/PATH/ADNI_DATA/volume/xcpd_work",
    "templateflow": "/ABSOLUTE/PATH/ADNI_DATA/volume/templateflow",
    "logs": "/ABSOLUTE/PATH/ADNI_DATA/volume/logs"
  },
  "runs": [
    {
      "subject": "999S9999",
      "session": "20200101"
    },
    {
      "subject": "998S9998",
      "session": "20200102",
      "paths": {
        "xcpd_output": "/ABSOLUTE/PATH/ADNI_DATA/volume/xcpd_second_visit",
        "xcpd_work": "/ABSOLUTE/PATH/ADNI_DATA/volume/xcpd_second_work"
      }
    }
  ],
  "postprocessing": {
    "smoothing_fwhm_mm": 6,
    "fd_threshold_mm": 0.5,
    "minimum_retained_seconds": 240,
    "high_pass_hz": 0.01,
    "low_pass_hz": 0.08,
    "maximum_censored_fraction": 0.3
  }
}
